<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculadora.MainPage"
             BackgroundColor="#000000">

	<!-- Estilos en cada botón -->
	<ContentPage.Resources>
		<Style x:Key="EstiloNumero" TargetType="Button">
			<Setter Property="BackgroundColor" Value="#121212" />
			<Setter Property="TextColor" Value="#E5E1E1" />
			<Setter Property="FontSize" Value="32" />
			<Setter Property="CornerRadius" Value="40" />
		</Style>
		<Style x:Key="EstiloFuncion" TargetType="Button">
			<Setter Property="BackgroundColor" Value="#A5A5A5" />
			<Setter Property="TextColor" Value="Black" />
			<Setter Property="FontSize" Value="32" />
			<Setter Property="CornerRadius" Value="40" />
		</Style>
		<Style x:Key="EstiloOperador" TargetType="Button">
			<Setter Property="BackgroundColor" Value="#FF9F0A" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="FontSize" Value="36" />
			<Setter Property="CornerRadius" Value="40" />
		</Style>
	</ContentPage.Resources>

	<Grid Padding="15" RowSpacing="12" ColumnSpacing="12">

		<Grid.RowDefinitions>
			<RowDefinition Height="2*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Pantalla -->
		<Label x:Name="lblPantalla"
               Text="0"
               TextColor="White"
               FontSize="70"
               MaxLines="1"
               LineBreakMode="HeadTruncation"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="End"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" />

		<!-- Fila 1 -->
		<Button Text="C" Style="{StaticResource EstiloFuncion}"
                Grid.Row="1" Grid.Column="0" Clicked="Limpiar_Clicked" />
		<Button Text="⌫" Style="{StaticResource EstiloFuncion}"
                Grid.Row="1" Grid.Column="1" Clicked="Borrar_Clicked" />
		<Button Text="%" Style="{StaticResource EstiloFuncion}"
                Grid.Row="1" Grid.Column="2" Clicked="Porcentaje_Clicked" />
		<Button Text="÷" Style="{StaticResource EstiloOperador}"
                Grid.Row="1" Grid.Column="3" Clicked="Operador_Clicked" />

		<!-- Fila 2 -->
		<Button Text="7" Style="{StaticResource EstiloNumero}"
                Grid.Row="2" Grid.Column="0" Clicked="Numero_Clicked" />
		<Button Text="8" Style="{StaticResource EstiloNumero}"
                Grid.Row="2" Grid.Column="1" Clicked="Numero_Clicked" />
		<Button Text="9" Style="{StaticResource EstiloNumero}"
                Grid.Row="2" Grid.Column="2" Clicked="Numero_Clicked" />
		<Button Text="×" Style="{StaticResource EstiloOperador}"
                Grid.Row="2" Grid.Column="3" Clicked="Operador_Clicked" />

		<!-- Fila 3 -->
		<Button Text="4" Style="{StaticResource EstiloNumero}"
                Grid.Row="3" Grid.Column="0" Clicked="Numero_Clicked" />
		<Button Text="5" Style="{StaticResource EstiloNumero}"
                Grid.Row="3" Grid.Column="1" Clicked="Numero_Clicked" />
		<Button Text="6" Style="{StaticResource EstiloNumero}"
                Grid.Row="3" Grid.Column="2" Clicked="Numero_Clicked" />
		<Button Text="-" Style="{StaticResource EstiloOperador}"
                Grid.Row="3" Grid.Column="3" Clicked="Operador_Clicked" />

		<!-- Fila 4 -->
		<Button Text="1" Style="{StaticResource EstiloNumero}"
                Grid.Row="4" Grid.Column="0" Clicked="Numero_Clicked" />
		<Button Text="2" Style="{StaticResource EstiloNumero}"
                Grid.Row="4" Grid.Column="1" Clicked="Numero_Clicked" />
		<Button Text="3" Style="{StaticResource EstiloNumero}"
                Grid.Row="4" Grid.Column="2" Clicked="Numero_Clicked" />
		<Button Text="+" Style="{StaticResource EstiloOperador}"
                Grid.Row="4" Grid.Column="3" Clicked="Operador_Clicked" />

		<!-- Fila 5 -->
		<Button Text="0" Style="{StaticResource EstiloNumero}"
                Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Clicked="Numero_Clicked" />
		<Button Text="." Style="{StaticResource EstiloNumero}"
                Grid.Row="5" Grid.Column="2" Clicked="Punto_Clicked" />
		<Button Text="=" Style="{StaticResource EstiloOperador}"
                Grid.Row="5" Grid.Column="3" Clicked="Igual_Clicked" />

	</Grid>
</ContentPage>